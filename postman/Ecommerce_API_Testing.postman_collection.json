{
  "info": {
    "name": "E-commerce API Testing",
    "description": "Postman collection for validating sample e-commerce APIs including authentication, products, cart, checkout, and orders.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "https://fakestoreapi.com" },
    { "key": "token", "value": "" },
    { "key": "productId", "value": "1" },
    { "key": "cartId", "value": "1" }
  ],
  "item": [
    {
      "name": "Login - Valid User",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"mor_2314\",\n  \"password\": \"83r5^_\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Response contains token', function () { pm.expect(pm.response.json()).to.have.property('token'); });",
              "if (pm.response.code === 200) { pm.collectionVariables.set('token', pm.response.json().token); }"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Get All Products",
      "request": {
        "method": "GET",
        "url": { "raw": "{{baseUrl}}/products", "host": ["{{baseUrl}}"], "path": ["products"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Product list is not empty', function () { pm.expect(pm.response.json().length).to.be.above(0); });"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Get Product By ID",
      "request": {
        "method": "GET",
        "url": { "raw": "{{baseUrl}}/products/{{productId}}", "host": ["{{baseUrl}}"], "path": ["products", "{{productId}}"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Product has title and price', function () { const json = pm.response.json(); pm.expect(json).to.have.property('title'); pm.expect(json).to.have.property('price'); });"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Get Invalid Product ID",
      "request": {
        "method": "GET",
        "url": { "raw": "{{baseUrl}}/products/999999", "host": ["{{baseUrl}}"], "path": ["products", "999999"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Invalid product should not return valid product data', function () { pm.expect(pm.response.json()).to.not.have.property('title'); });"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Create Cart",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userId\": 5,\n  \"date\": \"2026-04-29\",\n  \"products\": [\n    { \"productId\": 1, \"quantity\": 2 },\n    { \"productId\": 2, \"quantity\": 1 }\n  ]\n}"
        },
        "url": { "raw": "{{baseUrl}}/carts", "host": ["{{baseUrl}}"], "path": ["carts"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200 or 201', function () { pm.expect([200, 201]).to.include(pm.response.code); });",
              "pm.test('Cart contains products', function () { pm.expect(pm.response.json().products.length).to.be.above(0); });"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Get Cart By ID",
      "request": {
        "method": "GET",
        "url": { "raw": "{{baseUrl}}/carts/{{cartId}}", "host": ["{{baseUrl}}"], "path": ["carts", "{{cartId}}"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Cart has userId and products', function () { const json = pm.response.json(); pm.expect(json).to.have.property('userId'); pm.expect(json).to.have.property('products'); });"
            ],
            "type": "text/javascript"
          }
        }
      ]
    }
  ]
}

